<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/index.css" />

<main>
  <div id="filters" class="mt-3">
    <div id="AI" class="filter">
      <img src="src/filterIcons/image.png" alt="AI Icon" />
      <p>AI</p>
    </div>

    <div id="Nature" class="filter">
      <img src="src/filterIcons/leaf.png" alt="Nature Icon" />
      <p>Nature</p>
    </div>

    <div id="Abstract" class="filter">
      <img src="src/filterIcons/abstract-shape.png" alt="Abstract Icon" />
      <p>Abstract</p>
    </div>

    <div id="Cities" class="filter">
      <img src="src/filterIcons/city.png" alt="Cities Icon" />
      <p>Cities</p>
    </div>

    <div id="Animals" class="filter">
      <img src="src/filterIcons/paw.png" alt="Animals Icon" />
      <p>Animals</p>
    </div>

    <div id="Technology" class="filter">
      <img
        src="src/filterIcons/digital-transformation.png"
        alt="Technology Icon"
      />
      <p>Technology</p>
    </div>

    <div id="Travel" class="filter">
      <img src="src/filterIcons/travel.png" alt="Travel Icon" />
      <p>Travel</p>
    </div>

    <div id="Minimalist" class="filter">
      <img src="src/filterIcons/blur.png" alt="Minimalist Icon" />
      <p>Minimalist</p>
    </div>

    <div id="Space" class="filter">
      <img src="src/filterIcons/saturn.png" alt="Space Icon" />
      <p>Space</p>
    </div>

    <div id="Seasonal" class="filter">
      <img src="src/filterIcons/snowman.png" alt="Seasonal Icon" />
      <p>Seasonal</p>
    </div>

    <div id="Fantasy" class="filter">
      <img src="src/filterIcons/dragon.png" alt="Fantasy Icon" />
      <p>Fantasy</p>
    </div>

    <div id="Anime" class="filter">
      <img src="src/filterIcons/cloud.png" alt="Anime Icon" />
      <p>Anime</p>
    </div>

    <div id="Movies" class="filter">
      <img src="src/filterIcons/clapperboard.png" alt="Movies Icon" />
      <p>Movies</p>
    </div>

    <div id="Quotes" class="filter">
      <img src="src/filterIcons/quotation.png" alt="Quotes Icon" />
      <p>Quotes</p>
    </div>

    <div id="Vehicles" class="filter">
      <img src="src/filterIcons/car.png" alt="Vehicles Icon" />
      <p>Vehicles</p>
    </div>

    <div id="Food" class="filter">
      <img src="src/filterIcons/fast-food.png" alt="Foodcon" />
      <p>Food</p>
    </div>

    <div id="Sports" class="filter">
      <img src="src/filterIcons/football.png" alt="Sports Icon" />
      <p>Sports</p>
    </div>

    <div id="Art" class="filter">
      <img src="src/filterIcons/painting.png" alt="Art Icon" />
      <p>Art</p>
    </div>

    <div id="BlackAndWhite" class="filter">
      <img src="src/filterIcons/black-and-white.png" alt="B/W Icon" />
      <p>B/W</p>
    </div>

    <div id="Music" class="filter">
      <img src="src/filterIcons/musical-note.png" alt="Music Icon" />
      <p>Music</p>
    </div>

    <div id="FantasyLandscapes" class="filter">
      <img src="src/filterIcons/landscape.png" alt="Fantasy Landscapes Icon" />
      <p>Landscapes</p>
    </div>
  </div>

  <!-- Tool Bar -->
  <div id="toolbar" class="mb-5 mt-5">
    <div class="tool">
      <img src="src/tools/brush.png" />
      <span>Canvas</span>
    </div>
    <div class="tool">
      <img src="src/tools/infinity.png" />
      <span>Flow State</span>
    </div>
    <div class="tool video">
      <img src="src/tools/film.png" />
      <span>Video</span>
    </div>

    <a class="tool ai-btn-container" href="/ai">
      <img src="src/tools/magic-wand.png" />
      <span class="ai-btn">Generate</span>
    </a>

    <div class="tool">
      <img src="src/tools/adjust.png" />
      <span>Upscaler</span>
    </div>
    <div class="tool">
      <img src="src/tools/photo-editing.png" />
      <span>Editor</span>
    </div>
    <div class="border-0 tool more">
      <img src="src/tools/application.png" />
      <span>More</span>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container mb-5">
    <h2 id="filter-title" class="d-none"></h2>

    <div class="row">
      <div class="col-6 col-lg-2 p-1 mt-2 mb-3">
        <div class="dropdown w-100">
          <button
            class="btn btn-light border dropdown-toggle w-100 text-start"
            type="button"
            data-bs-toggle="dropdown"
          >
            All Orientations
          </button>
          <ul class="dropdown-menu w-100">
            <li><a class="dropdown-item" href="#">Horizontal</a></li>
            <li><a class="dropdown-item" href="#">Vertical</a></li>
            <li><a class="dropdown-item" href="#">Square</a></li>
          </ul>
        </div>
      </div>

      <div class="col-6 col-lg-2 p-1 mt-2 mb-3">
        <div class="dropdown w-100">
          <button
            class="btn btn-light border dropdown-toggle w-100 text-start"
            type="button"
            data-bs-toggle="dropdown"
          >
            Newest
          </button>
          <ul class="dropdown-menu w-100">
            <li><a class="dropdown-item" href="#">Newest</a></li>
            <li><a class="dropdown-item" href="#">Trending</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Masonry Grid -->
    <div class="row g-3" id="wallpaper-grid">
      <% for(let wallpaper of wallpapers) { %>
      <div class="col-6 col-sm-4 col-md-2">
        <div
          class="card shadow-lg border-0 rounded-4 overflow-hidden position-relative"
        >
          <a href="/wallpapers/<%= wallpaper._id %>" class="wallpaper-link">
            <img
              loading="lazy"
              src="<%= wallpaper.image.url %>"
              class="card-img-top img-fluid"
              alt="<%= wallpaper.title %>"
              style="object-fit: cover"
            />
          </a>
          <a
            download
            href="<%= wallpaper.image.url.replace('/upload/', `/upload/fl_attachment:${wallpaper.title.replace(/\s+/g, '_')}`) %>"
            title="Download wallpaper"
            class="download-btn btn"
          >
            <img src="src/tools/brush.png" />
          </a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</main>

<!-- Scripts -->
<script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const grid = document.querySelector("#wallpaper-grid");
    imagesLoaded(grid, function () {
      new Masonry(grid, {
        itemSelector: ".col-6",
        percentPosition: true,
      });
    });
  });
</script>
<script src="/js/home.js"></script>
